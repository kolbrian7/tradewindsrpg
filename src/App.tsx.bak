import React, { useState } from 'react';
import { useGame } from './GameContext';
import { EconomyEngine, COMMODITIES } from './engine/economy';

const App: React.FC = () => {
  const { player, ports, rumors, buyCommodity, sellCommodity, travelToPort, bribeForRumor, repairShip, upgradeShip } = useGame();
  const [activeTab, setActiveTab] = useState<'market' | 'cantina' | 'shipyard' | 'map'>('market');

  const currentPort = ports.find(p => p.id === player.currentPortId);
  const currentCargo = Object.values(player.cargo).reduce((a, b) => a + b, 0);
  const maxCargo = player.fleet.reduce((a, b) => a + b.cargoCapacity, 0);
  const flagship = player.fleet[0];

  if (!currentPort) return <div>Loading...</div>;

  return (
    <div className="flex flex-col h-screen bg-slate-900 text-slate-100 font-sans max-w-md mx-auto overflow-hidden">
      {/* Stat Bar */}
      <div className="bg-slate-800 p-4 border-b border-slate-700 grid grid-cols-2 gap-2 shadow-lg z-10">
        <div className="flex flex-col">
          <span className="text-xs text-slate-400 uppercase font-bold">Gold</span>
          <span className="text-xl font-bold text-yellow-500">{player.gold.toLocaleString()}</span>
        </div>
        <div className="flex flex-col items-end">
          <span className="text-xs text-slate-400 uppercase font-bold">Rank</span>
          <span className="text-lg font-semibold text-blue-400">{player.rank}</span>
        </div>
        <div className="flex flex-col">
          <span className="text-xs text-slate-400 uppercase font-bold">Cargo</span>
          <span className="text-sm font-medium">{currentCargo} / {maxCargo}</span>
        </div>
        <div className="flex flex-col items-end">
          <span className="text-xs text-slate-400 uppercase font-bold">Day</span>
          <span className="text-sm font-medium">{player.gameDay}</span>
        </div>
      </div>

      {/* Port Header */}
      <div className="p-4 bg-slate-800/50 backdrop-blur-sm border-b border-slate-700/50">
        <h1 className="text-2xl font-black italic tracking-tighter text-white uppercase">{currentPort.name}</h1>
        <p className="text-xs text-slate-400">Danger Level: {'💀'.repeat(currentPort.dangerLevel)}</p>
      </div>

      {/* Main Content Area */}
      <div className="flex-1 overflow-y-auto p-4 space-y-4">
        {activeTab === 'market' && (
          <div className="space-y-3 pb-4">
            {COMMODITIES.map((type) => {
              const commodity = currentPort.market[type];
              const price = EconomyEngine.calculatePrice(commodity);
              const playerAmount = player.cargo[type];

              return (
                <div key={type} className="bg-slate-800 border border-slate-700 p-3 rounded-xl flex items-center justify-between shadow-md transition-all active:scale-95">
                  <div>
                    <h3 className="font-bold text-lg">{type}</h3>
                    <p className="text-xs text-slate-400">Owned: {playerAmount}</p>
                  </div>
                  <div className="flex items-center space-x-3">
                    <span className="text-lg font-mono text-yellow-400">P{price}</span>
                    <div className="flex flex-col space-y-1">
                      <button 
                        onClick={() => buyCommodity(type, 1)}
                        disabled={player.gold < price || currentCargo >= maxCargo}
                        className="bg-green-600 hover:bg-green-500 disabled:opacity-30 px-3 py-1 rounded text-xs font-bold uppercase min-w-[60px]"
                      >
                        Buy
                      </button>
                      <button 
                        onClick={() => sellCommodity(type, 1)}
                        disabled={playerAmount <= 0}
                        className="bg-red-600 hover:bg-red-500 disabled:opacity-30 px-3 py-1 rounded text-xs font-bold uppercase min-w-[60px]"
                      >
                        Sell
                      </button>
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        )}

        {activeTab === 'cantina' && (
          <div className="space-y-6 flex flex-col items-center justify-center py-4 text-center">
            <div className="bg-slate-800 p-6 rounded-2xl border-2 border-slate-700 w-full shadow-xl">
              <span className="text-4xl mb-4 block animate-bounce">🍺</span>
              <h2 className="text-xl font-bold mb-2">The Salty Spitter</h2>
              <p className="text-sm text-slate-400 mb-6 italic">"Got some gold? I might have some info for ya."</p>
              
              <button 
                onClick={bribeForRumor}
                disabled={player.gold < 50}
                className="w-full bg-yellow-600 hover:bg-yellow-500 disabled:opacity-50 py-3 rounded-xl font-bold uppercase shadow-lg shadow-yellow-900/30 transition-all active:translate-y-1 mb-4"
              >
                Bribe Barkeep (P50)
              </button>
              
              <div className="mt-8 space-y-3 text-left">
                <h3 className="text-xs font-bold uppercase text-slate-500 tracking-widest border-b border-slate-700 pb-1">Recent Rumors</h3>
                {rumors.length === 0 ? (
                  <p className="text-sm italic text-slate-600">No active rumors...</p>
                ) : (
                  rumors.map(rumor => (
                    <div key={rumor.id} className="bg-slate-900/50 p-3 rounded-lg border border-slate-800 text-sm italic text-blue-300 animate-in fade-in slide-in-from-top-1">
                      "{rumor.text}"
                    </div>
                  ))
                )}
              </div>
            </div>
          </div>
        )}

        {activeTab === 'shipyard' && (
          <div className="space-y-4">
            {/* Ship Status Card */}
            <div className="bg-slate-800 p-5 rounded-2xl border border-slate-700 shadow-lg">
              <div className="flex justify-between items-start mb-4">
                <div>
                  <h2 className="text-xl font-bold text-white uppercase italic">{flagship.name}</h2>
                  <p className="text-xs text-slate-400">{flagship.shipClass}</p>
                </div>
                <span className="text-3xl">🏗️</span>
              </div>
              
              <div className="space-y-3">
                <div>
                  <div className="flex justify-between text-xs mb-1 uppercase font-bold">
                    <span>Hull Integrity</span>
                    <span>{flagship.hullHealth.current} / {flagship.hullHealth.max}</span>
                  </div>
                  <div className="w-full bg-slate-900 rounded-full h-2 overflow-hidden border border-slate-700">
                    <div 
                      className={`h-full transition-all duration-500 ${flagship.hullHealth.current / flagship.hullHealth.max < 0.3 ? 'bg-red-500' : 'bg-blue-500'}`}
                      style={{ width: `${(flagship.hullHealth.current / flagship.hullHealth.max) * 100}%` }}
                    />
                  </div>
                </div>

                <div className="grid grid-cols-2 gap-4 pt-2">
                  <div className="bg-slate-900/50 p-2 rounded border border-slate-800">
                    <span className="text-[10px] text-slate-500 block uppercase">Speed</span>
                    <span className="text-lg font-bold">{flagship.speed} knots</span>
                  </div>
                  <div className="bg-slate-900/50 p-2 rounded border border-slate-800">
                    <span className="text-[10px] text-slate-500 block uppercase">Firepower</span>
                    <span className="text-lg font-bold">{flagship.firepower} cannons</span>
                  </div>
                </div>
              </div>

              {flagship.hullHealth.current < flagship.hullHealth.max && (
                <button 
                  onClick={repairShip}
                  className="w-full mt-6 bg-blue-600 hover:bg-blue-500 py-3 rounded-xl font-bold uppercase shadow-lg shadow-blue-900/30"
                >
                  Repair Hull (P{(flagship.hullHealth.max - flagship.hullHealth.current) * 10})
                </button>
              )}
            </div>

            {/* Upgrades List */}
            <div className="space-y-2">
              <h3 className="text-xs font-bold uppercase text-slate-500 tracking-widest mt-4">Available Upgrades</h3>
              {[
                { name: 'Reinforced Hull', cost: 300, desc: '+10 Max Hull HP', icon: '🛡️' },
                { name: 'Expanded Hold', cost: 500, desc: '+5 Cargo Space', icon: '📦' },
                { name: 'Silk Sails', cost: 400, desc: '+2 Travel Speed', icon: '💨' }
              ].map(upgrade => (
                <button
                  key={upgrade.name}
                  onClick={() => upgradeShip(upgrade.name, upgrade.cost)}
                  disabled={player.gold < upgrade.cost}
                  className="w-full bg-slate-800 border border-slate-700 p-4 rounded-xl flex items-center justify-between group hover:border-yellow-500/50 disabled:opacity-50"
                >
                  <div className="flex items-center space-x-3">
                    <span className="text-2xl">{upgrade.icon}</span>
                    <div className="text-left">
                      <h4 className="font-bold">{upgrade.name}</h4>
                      <p className="text-[10px] text-slate-400 uppercase">{upgrade.desc}</p>
                    </div>
                  </div>
                  <span className="text-yellow-500 font-bold">P{upgrade.cost}</span>
                </button>
              ))}
            </div>
          </div>
        )}

        {activeTab === 'map' && (
          <div className="grid grid-cols-1 gap-4 pb-4">
            <h2 className="text-xs font-bold uppercase text-slate-500 tracking-widest">Select Destination</h2>
            {ports.filter(p => p.id !== player.currentPortId).map(port => (
              <button
                key={port.id}
                onClick={() => travelToPort(port.id)}
                className="bg-slate-800 border border-slate-700 p-6 rounded-2xl flex items-center justify-between hover:border-blue-500 transition-all active:scale-95 group shadow-lg"
              >
                <div className="text-left">
                  <h3 className="font-bold text-xl group-hover:text-blue-400 transition-colors uppercase italic">{port.name}</h3>
                  <p className="text-sm text-slate-400">Danger: {'💀'.repeat(port.dangerLevel)}</p>
                </div>
                <span className="text-2xl group-hover:translate-x-1 transition-transform">⛵</span>
              </button>
            ))}
          </div>
        )}
      </div>

      {/* Navigation Bar */}
      <div className="bg-slate-800 border-t border-slate-700 grid grid-cols-4 h-20 shadow-[0_-10px_20px_rgba(0,0,0,0.5)] z-10">
        <button 
          onClick={() => setActiveTab('market')}
          className={`flex flex-col items-center justify-center space-y-1 transition-colors ${activeTab === 'market' ? 'text-yellow-500' : 'text-slate-500'}`}
        >
          <span className="text-xl">⚖️</span>
          <span className="text-[9px] font-bold uppercase tracking-tighter">Market</span>
        </button>
        <button 
          onClick={() => setActiveTab('cantina')}
          className={`flex flex-col items-center justify-center space-y-1 transition-colors ${activeTab === 'cantina' ? 'text-yellow-500' : 'text-slate-500'}`}
        >
          <span className="text-xl">🍺</span>
          <span className="text-[9px] font-bold uppercase tracking-tighter">Cantina</span>
        </button>
        <button 
          onClick={() => setActiveTab('shipyard')}
          className={`flex flex-col items-center justify-center space-y-1 transition-colors ${activeTab === 'shipyard' ? 'text-yellow-500' : 'text-slate-500'}`}
        >
          <span className="text-xl">🏗️</span>
          <span className="text-[9px] font-bold uppercase tracking-tighter">Shipyard</span>
        </button>
        <button 
          onClick={() => setActiveTab('map')}
          className={`flex flex-col items-center justify-center space-y-1 transition-colors ${activeTab === 'map' ? 'text-yellow-500' : 'text-slate-500'}`}
        >
          <span className="text-xl">🗺️</span>
          <span className="text-[9px] font-bold uppercase tracking-tighter">Voyage</span>
        </button>
      </div>
    </div>
  );
};

export default App;
